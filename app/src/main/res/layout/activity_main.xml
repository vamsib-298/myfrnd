<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <ScrollView
        android:id="@+id/dashboardScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/dashboardContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/dashboard_padding">

            <!-- Clean Top Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/app_name"
                    android:textSize="26sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_primary"
                    android:tag="heading" />

                <Button
                    android:id="@+id/tvEngineStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="@drawable/bg_pill_inactive"
                    android:text="@string/status_ready"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/primary"
                    android:accessibilityLiveRegion="polite" />
            </LinearLayout>

            <!-- Single Overlay Permission Banner (Hidden once granted) -->
            <LinearLayout
                android:id="@+id/llMandatoryOverlayBanner"
                style="@style/Card"
                android:layout_marginTop="14dp"
                android:padding="16dp">

                <TextView
                    style="@style/SectionTitle"
                    android:textSize="17sp"
                    android:text="@string/permission_title" />

                <TextView
                    style="@style/BodyText"
                    android:textSize="13sp"
                    android:text="@string/permission_description" />

                <Button
                    android:id="@+id/btnMandatoryGrant"
                    style="@style/PrimaryButton"
                    android:layout_marginTop="12dp"
                    android:text="@string/grant_overlay" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvRuntimeError"
                style="@style/BodyText"
                android:layout_marginTop="10dp"
                android:textColor="@color/error"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone" />

            <!-- Companion Stage Card -->
            <LinearLayout
                style="@style/Card"
                android:background="@drawable/bg_hero_glow"
                android:layout_marginTop="12dp"
                android:padding="16dp">

                <com.wellness.overlay3d.overlay.HumanCompanionView
                    android:id="@+id/liveDashboardCompanion"
                    android:layout_width="match_parent"
                    android:layout_height="210dp"
                    android:contentDescription="@string/tap_companion" />

                <TextView
                    android:id="@+id/tvLiveCompanionSpeech"
                    style="@style/BodyText"
                    android:layout_marginTop="4dp"
                    android:text="@string/demo_message"
                    android:gravity="center"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:accessibilityLiveRegion="polite" />

                <Button
                    android:id="@+id/btnTestCompanionNow"
                    style="@style/PrimaryButton"
                    android:layout_marginTop="10dp"
                    android:text="@string/preview_companion" />
            </LinearLayout>

            <!-- Screen Break Card (20-20-20 Rule) -->
            <LinearLayout
                style="@style/Card"
                android:layout_marginTop="12dp"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SectionTitle"
                            android:text="@string/eye_title" />

                        <TextView
                            style="@style/BodyText"
                            android:layout_marginTop="2dp"
                            android:textSize="12sp"
                            android:text="@string/eye_subtitle" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvEyeCountdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:tag="metric"
                        android:layout_marginEnd="10dp"
                        android:text="@string/countdown_paused"
                        android:textColor="@color/primary"
                        android:textSize="19sp"
                        android:fontFamily="sans-serif-medium" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchScreenBreak"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:checked="true" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/eyeProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_marginTop="8dp"
                    android:max="1000"
                    android:importantForAccessibility="no"
                    android:progressTint="@color/primary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <HorizontalScrollView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">

                            <Button android:id="@+id/chipEye15" style="@style/Choice" android:minWidth="44dp" android:minHeight="38dp" android:paddingStart="10dp" android:paddingEnd="10dp" android:text="@string/minutes_15" />
                            <Button android:id="@+id/chipEye20" style="@style/Choice" android:minWidth="44dp" android:minHeight="38dp" android:paddingStart="10dp" android:paddingEnd="10dp" android:text="@string/minutes_20" />
                            <Button android:id="@+id/chipEye30" style="@style/Choice" android:minWidth="44dp" android:minHeight="38dp" android:paddingStart="10dp" android:paddingEnd="10dp" android:text="@string/minutes_30" />
                            <Button android:id="@+id/chipEye45" style="@style/Choice" android:minWidth="44dp" android:minHeight="38dp" android:paddingStart="10dp" android:paddingEnd="10dp" android:text="@string/minutes_45" />
                        </LinearLayout>
                    </HorizontalScrollView>

                    <Button
                        android:id="@+id/btnStartBreakNow"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:layout_marginStart="8dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:background="@drawable/bg_pill_active"
                        android:text="@string/take_break_now"
                        android:textAllCaps="false"
                        android:textColor="@color/on_primary"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>
            </LinearLayout>

            <!-- Water Break Card -->
            <LinearLayout
                style="@style/Card"
                android:layout_marginTop="12dp"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SectionTitle"
                            android:text="@string/water_title" />

                        <TextView
                            style="@style/BodyText"
                            android:layout_marginTop="2dp"
                            android:textSize="12sp"
                            android:text="@string/water_subtitle" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvWaterCountdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:tag="metric"
                        android:layout_marginEnd="10dp"
                        android:text="@string/countdown_paused"
                        android:textColor="@color/primary"
                        android:textSize="19sp"
                        android:fontFamily="sans-serif-medium" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchWaterBreak"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:checked="true" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/waterProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_marginTop="8dp"
                    android:max="1000"
                    android:importantForAccessibility="no"
                    android:progressTint="@color/primary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <HorizontalScrollView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">

                            <Button android:id="@+id/chipWater15" style="@style/Choice" android:minWidth="44dp" android:minHeight="38dp" android:paddingStart="10dp" android:paddingEnd="10dp" android:text="@string/minutes_15" />
                            <Button android:id="@+id/chipWater30" style="@style/Choice" android:minWidth="44dp" android:minHeight="38dp" android:paddingStart="10dp" android:paddingEnd="10dp" android:text="@string/minutes_30" />
                            <Button android:id="@+id/chipWater45" style="@style/Choice" android:minWidth="44dp" android:minHeight="38dp" android:paddingStart="10dp" android:paddingEnd="10dp" android:text="@string/minutes_45" />
                            <Button android:id="@+id/chipWater60" style="@style/Choice" android:minWidth="44dp" android:minHeight="38dp" android:paddingStart="10dp" android:paddingEnd="10dp" android:text="@string/minutes_60" />
                        </LinearLayout>
                    </HorizontalScrollView>

                    <Button
                        android:id="@+id/btnSipWaterNow"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:layout_marginStart="8dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:background="@drawable/bg_pill_active"
                        android:text="@string/sip_water_now"
                        android:textAllCaps="false"
                        android:textColor="@color/on_primary"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>
            </LinearLayout>

            <!-- Compact Voice Reminders Toggle -->
            <LinearLayout
                style="@style/Card"
                android:layout_marginTop="12dp"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SectionTitle"
                        android:textSize="16sp"
                        android:text="@string/voice_label" />

                    <TextView
                        style="@style/BodyText"
                        android:layout_marginTop="2dp"
                        android:textSize="12sp"
                        android:text="@string/voice_subtitle" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchVoice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:checked="true" />
            </LinearLayout>

            <!-- Notes & Reminders Card -->
            <LinearLayout
                style="@style/Card"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SectionTitle"
                        android:layout_width="wrap_content"
                        android:text="@string/tasks_title" />

                    <TextView
                        android:id="@+id/tvTaskCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:paddingStart="9dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="9dp"
                        android:paddingBottom="2dp"
                        android:background="@drawable/bg_pill_inactive"
                        android:text="0"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/primary" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <Button
                        android:id="@+id/btnAddNewTask"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:background="@drawable/bg_pill_active"
                        android:text="@string/add_task"
                        android:textAllCaps="false"
                        android:textColor="@color/on_primary"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvTaskError"
                    style="@style/BodyText"
                    android:textColor="@color/error"
                    android:accessibilityLiveRegion="polite"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/llTasksContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tvEmptyTasks"
                    style="@style/BodyText"
                    android:layout_marginTop="8dp"
                    android:text="@string/empty_tasks"
                    android:gravity="center"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</FrameLayout>
