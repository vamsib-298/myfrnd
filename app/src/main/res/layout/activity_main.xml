<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:id="@+id/dashboardScroll">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/dashboard_padding"
            android:id="@+id/dashboardContent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:src="@mipmap/ic_launcher"
                    android:importantForAccessibility="no"
                    android:layout_marginEnd="10dp" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:layout_weight="1"
                    android:textSize="29sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="-0.04"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="0dp"
                    android:tag="heading"
                    style="@style/BodyText" />
                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_ready"
                    android:accessibilityLiveRegion="polite"
                    android:id="@+id/tvEngineStatusBadge"
                    style="@style/Action" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/task_storage_error"
                android:visibility="gone"
                android:textColor="@color/error"
                android:accessibilityLiveRegion="polite"
                android:id="@+id/tvRuntimeError"
                style="@style/BodyText" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="0dp"
                android:clipToOutline="true"
                style="@style/Card">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/your_companion"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="10dp"
                    style="@style/SectionTitle" />
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="176dp">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/studio_arch"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY" />
                    <com.wellness.overlay3d.overlay.HumanCompanionView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/tap_companion"
                        android:id="@+id/liveDashboardCompanion" />
                </FrameLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="14dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/demo_message"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:accessibilityLiveRegion="polite"
                        android:id="@+id/tvLiveCompanionSpeech"
                        style="@style/BodyText" />
                    <Button
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/preview_companion"
                        android:layout_marginTop="10dp"
                        android:id="@+id/btnTestCompanionNow"
                        style="@style/PrimaryButton" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                style="@style/Card">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="1">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/focus_room"
                            style="@style/SectionTitle" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/focus_description"
                            android:layout_marginTop="3dp"
                            style="@style/BodyText" />
                    </LinearLayout>
                    <ImageView
                        android:layout_width="82dp"
                        android:layout_height="48dp"
                        android:src="@drawable/focus_cat_sleep"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp">
                    <Button
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/focus_start_25"
                        android:layout_weight="1"
                        android:layout_marginTop="0dp"
                        android:id="@+id/btnFocusToggle"
                        style="@style/PrimaryButton" />
                    <Button
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/focus_25m"
                        android:layout_marginStart="10dp"
                        android:id="@+id/btnFocusDuration"
                        style="@style/Action" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_hero_glow"
                android:visibility="gone"
                android:id="@+id/llMandatoryOverlayBanner"
                style="@style/Card">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/permission_title"
                    style="@style/SectionTitle" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/permission_description"
                    style="@style/BodyText" />
                <Button
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/grant_overlay"
                    android:layout_marginTop="10dp"
                    android:id="@+id/btnMandatoryGrant"
                    style="@style/Action" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="24dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/today_title"
                    android:textSize="24sp"
                    style="@style/SectionTitle" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:id="@+id/tvStreakBadge"
                    style="@style/BodyText" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp"
                    style="@style/Card">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_eye"
                            android:importantForAccessibility="no"
                            android:layout_marginEnd="10dp" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/eye_title"
                            android:layout_weight="1"
                            style="@style/SectionTitle" />
                        <androidx.appcompat.widget.SwitchCompat
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:contentDescription="@string/eye_title"
                            android:id="@+id/switchScreenBreak" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/eye_subtitle"
                        android:layout_marginTop="0dp"
                        style="@style/BodyText" />
                    <ProgressBar
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:max="1000"
                        android:progressTint="@color/primary"
                        android:progressBackgroundTint="@color/outline"
                        android:layout_marginTop="12dp"
                        android:id="@+id/eyeProgress"
                        style="?android:attr/progressBarStyleHorizontal" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="10dp">
                        <Button
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/minutes_15"
                            android:layout_weight="1"
                            android:minWidth="0dp"
                            android:paddingStart="2dp"
                            android:paddingEnd="2dp"
                            android:layout_marginEnd="4dp"
                            android:id="@+id/chipEye15"
                            style="@style/Choice" />
                        <Button
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/minutes_20"
                            android:layout_weight="1"
                            android:minWidth="0dp"
                            android:paddingStart="2dp"
                            android:paddingEnd="2dp"
                            android:layout_marginEnd="4dp"
                            android:id="@+id/chipEye20"
                            style="@style/Choice" />
                        <Button
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/minutes_30"
                            android:layout_weight="1"
                            android:minWidth="0dp"
                            android:paddingStart="2dp"
                            android:paddingEnd="2dp"
                            android:layout_marginEnd="4dp"
                            android:id="@+id/chipEye30"
                            style="@style/Choice" />
                        <Button
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/minutes_45"
                            android:layout_weight="1"
                            android:minWidth="0dp"
                            android:paddingStart="2dp"
                            android:paddingEnd="2dp"
                            android:layout_marginEnd="4dp"
                            android:id="@+id/chipEye45"
                            style="@style/Choice" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="6dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/countdown_paused"
                            android:layout_weight="1"
                            android:fontFamily="monospace"
                            android:layout_marginTop="0dp"
                            android:textColor="@color/text_primary"
                            android:id="@+id/tvEyeCountdown"
                            style="@style/BodyText" />
                        <Button
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/take_break_now"
                            android:id="@+id/btnStartBreakNow"
                            style="@style/Action" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp"
                    style="@style/Card">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_water"
                            android:importantForAccessibility="no"
                            android:layout_marginEnd="10dp" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/water_title"
                            android:layout_weight="1"
                            style="@style/SectionTitle" />
                        <androidx.appcompat.widget.SwitchCompat
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:contentDescription="@string/water_title"
                            android:id="@+id/switchWaterBreak" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/water_subtitle"
                        android:layout_marginTop="0dp"
                        style="@style/BodyText" />
                    <ProgressBar
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:max="1000"
                        android:progressTint="@color/primary"
                        android:progressBackgroundTint="@color/outline"
                        android:layout_marginTop="12dp"
                        android:id="@+id/waterProgress"
                        style="?android:attr/progressBarStyleHorizontal" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="10dp">
                        <Button
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/minutes_15"
                            android:layout_weight="1"
                            android:minWidth="0dp"
                            android:paddingStart="2dp"
                            android:paddingEnd="2dp"
                            android:layout_marginEnd="4dp"
                            android:id="@+id/chipWater15"
                            style="@style/Choice" />
                        <Button
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/minutes_30"
                            android:layout_weight="1"
                            android:minWidth="0dp"
                            android:paddingStart="2dp"
                            android:paddingEnd="2dp"
                            android:layout_marginEnd="4dp"
                            android:id="@+id/chipWater30"
                            style="@style/Choice" />
                        <Button
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/minutes_45"
                            android:layout_weight="1"
                            android:minWidth="0dp"
                            android:paddingStart="2dp"
                            android:paddingEnd="2dp"
                            android:layout_marginEnd="4dp"
                            android:id="@+id/chipWater45"
                            style="@style/Choice" />
                        <Button
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/minutes_60"
                            android:layout_weight="1"
                            android:minWidth="0dp"
                            android:paddingStart="2dp"
                            android:paddingEnd="2dp"
                            android:layout_marginEnd="4dp"
                            android:id="@+id/chipWater60"
                            style="@style/Choice" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="6dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/countdown_paused"
                            android:layout_weight="1"
                            android:fontFamily="monospace"
                            android:layout_marginTop="0dp"
                            android:textColor="@color/text_primary"
                            android:id="@+id/tvWaterCountdown"
                            style="@style/BodyText" />
                        <Button
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sip_water_now"
                            android:id="@+id/btnSipWaterNow"
                            style="@style/Action" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                style="@style/Card">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/tasks_title"
                        android:layout_weight="1"
                        style="@style/SectionTitle" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:layout_marginEnd="12dp"
                        android:textSize="14sp"
                        android:id="@+id/tvTaskCount" />
                    <Button
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/add_task"
                        android:id="@+id/btnAddNewTask"
                        style="@style/Action" />
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/task_storage_error"
                    android:visibility="gone"
                    android:textColor="@color/error"
                    android:id="@+id/tvTaskError"
                    style="@style/BodyText" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:id="@+id/llTasksContainer" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/empty_tasks"
                    android:id="@+id/tvEmptyTasks"
                    style="@style/BodyText" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                style="@style/Card">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/smart_settings_title"
                    style="@style/SectionTitle" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/voice_label"
                        android:layout_weight="1"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="0dp"
                        style="@style/BodyText" />
                    <androidx.appcompat.widget.SwitchCompat
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:contentDescription="@string/voice_label"
                        android:id="@+id/switchVoice" />
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/voice_subtitle"
                    android:layout_marginTop="0dp"
                    style="@style/BodyText" />
                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/headphones_only_label"
                    android:layout_marginTop="8dp"
                    android:id="@+id/btnHeadphonesOnly"
                    style="@style/Action" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/wind_down_label"
                        android:layout_weight="1"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="0dp"
                        style="@style/BodyText" />
                    <androidx.appcompat.widget.SwitchCompat
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:contentDescription="@string/wind_down_label"
                        android:id="@+id/switchWindDown" />
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/wind_down_subtitle"
                    android:layout_marginTop="0dp"
                    style="@style/BodyText" />
                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/wind_down_review_btn"
                    android:layout_marginTop="8dp"
                    android:id="@+id/btnTriggerWindDown"
                    style="@style/Action" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/scan_credit"
                android:layout_marginTop="18dp"
                android:textSize="12sp"
                android:id="@+id/scanCredit"
                style="@style/BodyText" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
