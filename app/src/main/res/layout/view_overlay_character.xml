<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="center_horizontal|bottom"
    android:orientation="vertical"
    android:padding="6dp">

    <!-- Main Interactive Speech Card -->
    <LinearLayout
        android:id="@+id/speechBubbleContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_speech_bubble"
        android:elevation="8dp"
        android:focusable="true"
        android:minWidth="220dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tvOverlayTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:letterSpacing="0.04" />

        <TextView
            android:id="@+id/speechText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:lineSpacingExtra="2dp"
            android:maxLines="4"
            android:maxWidth="244dp"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/breakProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="8dp"
            android:max="1000"
            android:progress="0"
            android:progressTint="@color/primary"
            android:visibility="gone" />

        <!-- Inline Quick Note Composer (expanded on + Note tap) -->
        <LinearLayout
            android:id="@+id/overlayQuickNoteBox"
            android:layout_width="244dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/etQuickOverlayNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:hint="@string/quick_note_hint"
                android:inputType="textCapSentences"
                android:maxLength="160"
                android:maxLines="2"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:importantForAutofill="no" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="end"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnCancelQuickNote"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_pill_inactive"
                    android:text="@string/cancel"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnSaveQuickNote"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/bg_pill_active"
                    android:text="@string/save"
                    android:textAllCaps="false"
                    android:textColor="@color/on_primary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/overlayActionsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnOverlayNoteChip"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_pill_inactive"
                android:text="@string/overlay_quick_note"
                android:textColor="@color/primary"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium" />

            <Button
                android:id="@+id/btnOverlaySecondary"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_pill_inactive"
                android:textColor="@color/text_primary"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium" />

            <Button
                android:id="@+id/btnOverlayPrimary"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/bg_pill_active"
                android:textColor="@color/on_primary"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
    </LinearLayout>

    <com.wellness.overlay3d.overlay.HumanCompanionView
        android:id="@+id/humanCompanionView"
        android:layout_width="180dp"
        android:layout_height="190dp" />

</LinearLayout>
